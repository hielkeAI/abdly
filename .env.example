# Supabase project settings (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated email addresses trusted as platform owners
OWNER_EMAILS=

# Stripe secret key, webhook signing secret, and billing portal configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=

# Discord application OAuth is configured as a Supabase auth provider.
# Discord bot must be in the configured server with Manage Roles permission.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_INVITE_URL=https://discord.gg/ZgkSePVHw

# Public application origin, e.g. https://abdlyai.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hugging Face OAuth app credentials (https://huggingface.co/settings/oauth)
HUGGINGFACE_CLIENT_ID=
HUGGINGFACE_CLIENT_SECRET=
